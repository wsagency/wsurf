    "%lld more" : {

    },
    "%lld more tabs not shown" : {
      "comment" : "Note at the end of another device’s list of tabs in the sidebar. That many tabs were left out because the shared list was too large. %lld is a number of at least 1. Sentence case.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
