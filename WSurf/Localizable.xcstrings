              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld visits"
                }
              }
            }
          }
        }
      }
    },
    "%lld websites" : {
      "comment" : "Count beside a permission row, saying how many websites have an answer saved for it. %lld is the number; use a plural variation if the language needs one.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
