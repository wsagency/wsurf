    "%lld tabs" : {
      "comment" : "How many tabs a profile has open, shown in the profile list and on a profile’s own page. It is joined to other fragments by “ · ”, so it is a fragment, not a sentence. %lld is the number of tabs.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tab"
