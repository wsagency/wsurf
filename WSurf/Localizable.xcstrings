    },
    "Show Assistant" : {

    },
    "Show Backup" : {
      "comment" : "External MCP client setup in Advanced settings."
    },
    "Show Blocked Pop-up" : {
      "comment" : "Tooltip on the toolbar button that appears after a website's pop-up was blocked. Pressing it opens that window in a new tab. Title Case."
    },
    "Show Certificate" : {
      "comment" : "Tooltip on the lock beside the address in the Website Settings popover. Opening it shows the website's certificate in the system panel. Title Case."
    },
    "Show Configuration" : {
      "comment" : "External MCP client setup in Advanced settings."
    },
    "Show details" : {

    },
    "Show Extension" : {
      "comment" : "Command in the right-click menu of an extension’s toolbar button, which puts the button back on the toolbar. The same item reads Hide Extension when it is already there, so the two should stay parallel. Title Case, Show is a verb."
    },
    "Show Frame Rate" : {
      "comment" : "Item in the Developer Tools menu that shows a small badge with the page’s frames per second over the page. A check mark shows when it is on. Show is a verb. Title Case."
    },
    "Show full website address" : {
      "comment" : "Title of a switch in the Browsing section of the General settings page. When on, the address bar shows the whole page address instead of only the website name."
    },
    "Mouse side buttons go back and forward" : {
      "comment" : "Title of a switch in the Browsing section of the General settings page. When on, the extra buttons on the side of a mouse (the ones most mice label back and forward) go back and forward in the page, like the Back and Forward commands."
    },
    "The back and forward buttons on the side of a mouse move through the page’s history. Turn off to leave them to websites." : {
      "comment" : "Caption under the Mouse side buttons go back and forward switch on the General settings page. “Turn off” means turning the switch off, which lets websites receive those mouse buttons themselves."
    },
    "Show in Finder" : {
      "comment" : "Tooltip on the small folder button beside a finished download, which reveals the file in the Finder. Finder is Apple’s app name — use Apple’s own name for it, and match Apple’s standard wording for this command."
    },
    "Show in Settings" : {
      "comment" : "Button on the Removed from iCloud card that opens the Settings tab where Sync with iCloud is."
    },
    "Show Last Tab" : {
      "comment" : "Hidden menu command under Window, shortcut ⌘9, which switches to the last tab in the row. Title Case and established platform terminology."
    },
    "Show link address" : {

    },
    "Show lyrics" : {
      "comment" : "Title of the switch on the General settings page that adds the lyrics button to the media player, and its settings-search title. Sentence case, as settings rows are."
    },
    "Show Lyrics" : {
      "comment" : "Tooltip on the lyrics button in the media player while the lyrics are hidden. Pairs with “Hide Lyrics”. Title Case."
    },
    "Show Lyrics Earlier" : {
      "comment" : "Tooltip on the − button at the foot of the lyrics view. It moves every line earlier against the sound. Pairs with “Show Lyrics Later”. Title Case."
    },
    "Show Lyrics Later" : {
      "comment" : "Tooltip on the + button at the foot of the lyrics view. It moves every line later against the sound. Pairs with “Show Lyrics Earlier”. Title Case."
    },
    "Show media player" : {
      "comment" : "Label of the switch on the General settings page that decides whether video and sound move into the player in the sidebar. Sentence case, as settings labels are."
    },
    "Show Micro Window" : {
      "comment" : "Item in the right-click menu of a sidebar row whose page is in a micro window. It brings that micro window to the front without moving the page. Title Case verb phrase, like “Move to Micro Window”."
    },
    "Show Next Tab" : {
      "comment" : "Menu bar command under Window, shortcuts ⇧⌘] and ⌃Tab, which switches to the tab after the current one. Title Case and established platform terminology."
    },
    "Show or hide the list of tabs." : {
      "comment" : "Description of the Show sidebar switch, shown only in the Settings search results. The list of tabs is the sidebar down the side of the window. Imperative pair with a final full stop."
    },
    "Show Original" : {
      "comment" : "Menu command that removes a page translation and shows the page's original text. Title Case."
    },
    "Show password" : {

    },
    "Show Peek" : {

    },
    "Show Previous Tab" : {
      "comment" : "Menu bar command under Window, shortcuts ⇧⌘[ and ⌃⇧Tab, which switches to the tab before the current one. Title Case and established platform terminology."
    },
    "Show Recent Downloads" : {
      "comment" : "VoiceOver action on the Downloads button at the foot of the sidebar. It opens the small list of the newest downloads, which otherwise opens only when the pointer rests on the button. Title Case."
    },
    "Show Side Panel" : {

    },
    "Show sidebar" : {
      "comment" : "Sentence case title of the Appearance settings row that turns the sidebar on, and the same wording in the Settings search index. Show is a verb. Deliberately sentence case, unlike the Title Case menu command with the same words."
    },
    "Show Sidebar" : {
      "comment" : "Menu bar command under View, shortcut ⌃⌘S, which reveals the tab sidebar. The same item reads Hide Sidebar when the sidebar is already showing, so the two should stay parallel. Title Case, Show is a verb."
    },
    "Show Tab %lld" : {
      "comment" : "Hidden menu commands under Window bound to ⌘1 through ⌘8. %lld is the tab’s position in the row, a number from 1 to 8. Title Case and established platform terminology."
    },
    "Show Tabs" : {
      "comment" : "In the Minimal window style: the View menu item, command palette command and tooltip of the bar’s tab button that slide in the list of tabs. Title Case."
    },
    "Show tabs from" : {
      "comment" : "VoiceOver label of the control at the top of the sidebar that chooses whose tabs the sidebar lists: This Mac or one of the person’s other devices. The control does not show this text. Sentence case."
    },
    "Show the whole address of the page in the address bar, not just the website name." : {
      "comment" : "Caption under the Show full website address switch on the General settings page."
    },
    "Show Video" : {
      "comment" : "Tooltip on the same eye button once the picture is hidden; it brings the picture back. Title Case, narrow dock."
    },
    "Show video in the player" : {
      "comment" : "Title of the only row on the Experiments settings page, and the title of that same row in Settings search. It turns on the picture inside the media player in the sidebar."
    },
    "show weak and reused passwords" : {
      "comment" : "Reason shown in the Touch ID or password prompt of Show Password Health on the Credentials page in Settings, before the list marks weak and reused passwords. It completes a system sentence like “WSurf is trying to …”, so it is a lowercase verb phrase with no period."
    },
    "Show Web Inspector" : {
      "comment" : "Command in View > Developer, in the Developer Tools menu and in the ⌘K palette (shortcut ⌥⌘I) that opens WebKit’s Web Inspector for the page. Web Inspector is established platform terminology and is the name Safari uses. Show is a verb. Title Case."
    },
    "Show what went wrong" : {
      "comment" : "Tooltip on the warning button beside an extension that reported problems; pressing it opens a panel listing them. Show is a verb."
    },
    "Show “%@”" : {
      "comment" : "VoiceOver action of the speaker button (one for each tab that is playing sound), item of the speaker's right-click menu (one for each such tab), and VoiceOver label of a tab in the list that opens from the speaker. It takes you to that tab: its window comes forward, its space and the tab are shown, and its row is scrolled into view in the sidebar. %@ is the title of the tab (a page title, never translated). The quotation marks are curly. Title Case verb phrase."
    },
    "Showing the original page" : {
      "comment" : "VoiceOver announcement after a translation is removed and the page's original text is back."
    },
    "Side by side" : {

    },
    "Sidebar" : {
      "comment" : "Title of the Appearance settings section for the tab sidebar. A noun heading beside an icon."
    },
    "Sign in" : {

    },
    "Sign In" : {
      "comment" : "Default button of the dialog a website shows when it asks for a username and password; pressing it submits what was typed. Title Case, imperative verb."
    },
    "Sign in again" : {

    },
    "Sign in to %@" : {
      "comment" : "Title of the dialog a website shows when it asks for a username and password. %@ is the address that asks, such as https://example.com or https://example.com:8443, or a proxy’s host and port."
    },
    "Sign in to this MCP connection in OpenAI settings." : {

    },
    "Sign in with the service" : {

    },
    "Sign in with your Apple Account in System Settings to share tabs." : {
      "comment" : "Note under the iCloud section of a profile’s settings page, shown when this Mac is not signed in to iCloud. Apple Account and System Settings are Apple’s own names: use the wording macOS uses in the target language. A sentence."
    },
    "Sign in with your Apple Account in System Settings to sync." : {
      "comment" : "Caption of the Sync with iCloud switch when no Apple Account is signed in, and the error shown when sync is turned on without one. System Settings is the macOS app."
