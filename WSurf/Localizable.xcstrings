    },
    "Stop watching a page." : {
      "comment" : "Caption for the Stop Watches tool in assistant settings."
    },
    "Watch page" : {
      "comment" : "Label in the assistant's activity details for a step where it set up a page watch. Sentence case, short verb phrase."
