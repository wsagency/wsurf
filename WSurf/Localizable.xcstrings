    "Preparing attachments…" : {

    },
    "Preparing update" : {
      "comment" : "Status line under the Software Update heading in Settings while the downloaded update is being unpacked. Sentence case."
    },
    "Preparing…" : {

    },
    "Press ⌘K to search, open a page, or ask a question." : {
      "comment" : "First of three things to try, on the last onboarding screen. ⌘K opens the command palette; keep the shortcut as it is."
    },
    "Press a shortcut. Press Escape to cancel." : {
      "comment" : "Tooltip on the keyboard-shortcut field in Settings while it is listening for a keystroke. It no longer appears as a line under the field. Escape is the name of the key — use the name printed on keyboards in the target language."
