                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tabs"
                }
              }
            }
          }
        }
      }
    },
    "%lld tabs playing audio" : {
      "comment" : "VoiceOver label of the speaker button when several tabs, in this window or in other windows of the same profile, are playing sound. %lld is the number of tabs, always 2 or more. Plural form of “1 tab playing audio”. Sentence case, no full stop."
    },
    "%lld visits" : {
      "comment" : "Caption on a frequently-visited site tile on the start page; %lld is how many times the user opened that site. One line in a narrow tile, sentence case.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
