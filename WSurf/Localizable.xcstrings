    "Preview %@" : {

    },
    "Preview File" : {
      "comment" : "Tooltip and VoiceOver label of the eye button beside a finished download, an item in its right-click menu, and a VoiceOver action on its row. It shows the file in the system’s Quick Look window without opening another app. A verb; not the noun Preview used for the update channel. Title Case."
    },
    "Previous (⇧⌘G)" : {
      "comment" : "Tooltip on the up-chevron in the find bar, which moves to the previous match on the page. ⇧⌘G is the keyboard shortcut — keyboard symbols, keep exactly, including the parentheses."
