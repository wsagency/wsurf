    "Sign out" : {

    },
    "Sign-in method" : {

    },
    "Sign-in was canceled." : {

    },
    "Sign-ins and cookies" : {
      "comment" : "Something a profile keeps separately from every other profile."
    },
    "Signs you out of most websites." : {
      "comment" : "Caption under the Cookies and site data checkbox in the Clear browsing data section, warning what clearing them will do. The implied subject is the clearing. Third person singular; website is one word."
    },
    "Since %@" : {
      "comment" : "How far back a profile’s history goes, joined to the page count by “ · ”. %@ is a date, such as “March 4”. A fragment, not a sentence."
    },
    "sing along with the track" : {
      "comment" : "Second line of the Show Lyrics row in the command palette, under the command name. A fragment, not a sentence: lower case and no final full stop, as every palette caption is."
    },
    "Sites get an address only when you choose it." : {

    },
    "Size" : {
      "comment" : "Submenu in the context menu of a sidebar folder that makes that one folder's row larger so it stands out: Normal, 1.5×, 2×, 2.5×. Title Case, one word."
    },
    "Skip" : {

    },
    "Skip Setup" : {
      "comment" : "Secondary button on the onboarding screens; ends onboarding without granting anything. Title Case."
    },
    "Skips the animations when switching layouts and opening Reader." : {
      "comment" : "Caption of the Fast transitions setting in Settings › Appearance › Window, and its Settings search summary. Layouts are the Standard and Minimal window styles. Reader is WSurf’s distraction-free reading view and keeps its name."
    },
    "Sleep inactive tabs" : {
      "comment" : "Title of the switch in Settings > General that lets WSurf release the pages of background tabs when the Mac runs short of memory or, with Sleep after, once they have been idle, and the same row in Settings search. Off by default. Sentence case; “Sleep” is a verb the browser does to the tabs."
    },
    "Sleep inactive tabs is off, so every website stays loaded." : {

    },
    "Sleep after" : {
      "comment" : "Title of the row in Settings > General, shown under Sleep inactive tabs, that chooses how long a background tab may sit out of view before it unloads. Sentence case; Sleep is a verb."
    },
    "Background tabs unload after they have been out of view this long, and reload when you open them. Tabs that play audio, use a camera or microphone, hold unsaved form input or are downloading stay loaded, and so do the Favorites and pinned tabs the options below keep awake. This covers WebKit and Chromium tabs; Chromium tabs restore their address and scroll position, not Back/Forward history." : {
      "comment" : "Caption of the Sleep after row in Settings > General. Explains the idle delay, which tabs are never unloaded, and what a woken Chromium tab restores. WebKit and Chromium are browser engine names and stay untranslated."
    },
    "Favorites never sleep" : {
      "comment" : "Title of the switch in Settings > General, shown under Sleep inactive tabs, that keeps Favorites loaded when other tabs sleep. On by default. Sentence case; Sleep is a verb the browser does to the tabs, and the same row in Settings search."
    },
    "Favorites stay loaded when tabs sleep, when you choose Free Memory and when memory runs low. A sleeping tab sends no notifications." : {
      "comment" : "Caption of the Favorites never sleep row in Settings > General, and its description in Settings search. Says what keeps Favorites loaded and that a tab that is asleep cannot send notifications. Free Memory is the name of a button."
    },
    "Pinned tabs never sleep" : {
      "comment" : "Title of the switch in Settings > General, shown under Sleep inactive tabs, that keeps pinned tabs loaded when other tabs sleep. Off by default. Sentence case; Sleep is a verb the browser does to the tabs, and the same row in Settings search."
    },
    "Pinned tabs stay loaded when tabs sleep, when you choose Free Memory and when memory runs low. A sleeping tab sends no notifications." : {
      "comment" : "Caption of the Pinned tabs never sleep row in Settings > General, and its description in Settings search. Says what keeps pinned tabs loaded and that a tab that is asleep cannot send notifications. Free Memory is the name of a button."
    },
    "Tint Icons as Folder" : {
      "comment" : "Item in the context menu of a sidebar folder, checked while on: draws the icons of the tabs inside the folder in the folder's color instead of their own colors. Off by default. Title Case, next to Size."
    },
    "When memory is low" : {
      "comment" : "Choice in the Sleep after menu that sets no idle delay: tabs unload only when the Mac runs short of memory. Sentence case."
    },
    "Custom…" : {
      "comment" : "Last choice in the Sleep after menu; reveals a field for a custom number of minutes or hours. Ends with an ellipsis because it asks for more input."
    },
    "Custom time" : {
      "comment" : "Title and accessibility label of the Settings row and field where a custom Sleep after duration is typed. Noun phrase, sentence case."
    },
    "Applied: %@" : {
      "comment" : "Caption under the Custom time field in Settings > General showing the Sleep after duration that is currently in effect, for example Applied: 1 hour 30 minutes. The placeholder is that formatted duration or the words When memory is low."
    },
    "minutes" : {
      "comment" : "Unit choice next to the Custom time field; lowercase plural noun."
