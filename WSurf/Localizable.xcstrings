                  "state" : "translated",
                  "value" : "%lld more tabs not shown"
                }
              }
            }
          }
        }
      }
    },
    "%lld of %lld" : {
      "comment" : "Match position in the find bar: current match, then total matches, e.g. “3 of 17”. Sits between the field and the arrow buttons.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of %2$lld"
          }
        }
      }
    },
    "%lld pages kept. Older pages are removed." : {
      "comment" : "Caption under the Keep history for row, saying how many pages the history holds now and that anything past the chosen age is dropped. %lld is the count of pages; use a plural variation if the language needs one. The alternative caption, shown when the history is empty, is No pages recorded yet."
    },
    "%lld pages of history" : {
      "comment" : "One figure in the summary line under a profile on the Profiles settings page, joined to the other figures by “ · ”. %lld is the number of pages that profile has in its history. A fragment, not a sentence.",
      "localizations" : {
