    "Show Archived Tabs" : {
      "comment" : "Command in the ⌘K palette that switches the palette to searching tabs WSurf archived automatically. Title Case, like a menu command. A caption beside it counts the archived tabs."
    },
    "Remove from Archive" : {
      "comment" : "Tooltip and VoiceOver action on the × button at the right of an archived tab in the ⌘K palette. It deletes that entry from the archive without opening the tab. Verb phrase, Title Case."
    },
    "Archive unused tabs" : {
      "comment" : "Title of the row in Settings > General > Tabs that chooses how long a background tab may sit unused before it closes into the archive, and the same row in Settings search. A pop-up menu completes it: After 12 hours, After a day, After a week, or Never. Sentence case."
    },
    "Archived tabs stay searchable from ⌘K. The newest 30 are kept." : {
      "comment" : "Caption under the Archive unused tabs row in Settings > General, and the description of that row in Settings search. ⌘K is the shortcut for the command palette; keep it as it is. 30 is how many archived tabs WSurf keeps, so keep the number."
    },
    "After 12 hours" : {
      "comment" : "Choice in the Archive unused tabs pop-up menu in Settings > General: a background tab closes into the archive once it has gone unused for 12 hours. Sentence case, one short line."
    },
    "After a day" : {
      "comment" : "Choice in the Archive unused tabs pop-up menu in Settings > General: a background tab closes into the archive once it has gone unused for a day. Sentence case, one short line."
    },
    "After a week" : {
      "comment" : "Choice in the Archive unused tabs pop-up menu in Settings > General: a background tab closes into the archive once it has gone unused for a week. Sentence case, one short line."
    },
    "The website will ask again to use your camera, microphone, location, or notifications. The assistant will ask again before reading any page on %@." : {
      "comment" : "Message of the confirmation for Reset this website in Settings > Websites. %@ is the whole website the assistant’s access covers, for example google.com when resetting maps.google.com: assistant access is reset for every page of that site."
    },
    "Show Reader" : {
      "comment" : "Menu command in View, and accessibility label of the Reader control in the address bar while the page is shown as it is. Reader shows only the article of a page, without the navigation, ads and other things around it. Pairs with “Hide Reader”. Title Case."
    },
    "Hide Reader" : {
      "comment" : "Menu command in View, and accessibility label of the Reader control in the address bar while Reader is on screen. It goes back to the page. Pairs with “Show Reader”. Title Case."
    },
    "Show Reader (⌥⌘R)" : {
      "comment" : "Tooltip on the Reader control in the address bar while the page is shown as it is. ⌥⌘R is the keyboard shortcut — keyboard symbols, keep exactly, including the parentheses. Pairs with “Hide Reader (⌥⌘R)”."
    },
    "Hide Reader (⌥⌘R)" : {
      "comment" : "Tooltip on the Reader control in the address bar while Reader is on screen, and on the Done button of the floating bar over the article. ⌥⌘R is the keyboard shortcut — keyboard symbols, keep exactly, including the parentheses."
    },
    "Text appearance" : {
      "comment" : "Tooltip on the button in Reader's floating bar that opens the choices for the article's text: size, theme and font. Sentence case."
    },
    "Make text smaller" : {
      "comment" : "Tooltip and accessibility label of the small A button in Reader's text appearance popover; it steps the article's text size down. Sentence case. Pairs with “Make text bigger”."
    },
    "Make text bigger" : {
      "comment" : "Tooltip and accessibility label of the large A button in Reader's text appearance popover; it steps the article's text size up. Sentence case. Pairs with “Make text smaller”."
    },
    "Font" : {
      "comment" : "Heading above the list of typefaces in Reader's text appearance popover. A noun; one short word."
    },
    "Reset to Defaults" : {
      "comment" : "Button at the bottom of Reader's text appearance popover that puts the article's text size, theme and font back to the original choices. Title Case, imperative."
    },
    "Sepia" : {
      "comment" : "Name of Reader's warm, paper-colored page theme, one of Automatic, Light, Sepia and Dark. It names a color, as in a sepia-toned photograph. Shown as the tooltip and accessibility label of a round color swatch."
    },
    "%lld min read" : {
      "comment" : "Reading time of an article in Reader, shown under its title beside the author's name. %lld is the number of minutes and is at least 1. Keep it short; it sits on one line."
    },
    "Memory" : {
      "comment" : "Title of the section and row on the Assistant settings page, and of the page they open, that lists the notes the assistant keeps about the person. A noun; one word."
    },
    "Notes about you that the assistant keeps on this Mac." : {
      "comment" : "Caption under the Memory row on the Assistant settings page."
    },
    "Not in private windows" : {
      "comment" : "Detail on the Memory row on the Assistant settings page in a private window, which keeps no notes. Short; it sits at the trailing edge of the row."
    },
    "%lld notes" : {
      "comment" : "Detail on the Memory row on the Assistant settings page: how many notes the assistant keeps. %lld is at least 1. Short; it sits at the trailing edge of the row.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld note"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld notes"
                }
              }
            }
          }
        }
      }
    },
    "What the assistant remembers about you. It saves your answers and what you ask it to remember. It never saves page content, passwords, or payment details." : {
      "comment" : "Caption under the title of Settings › Assistant › Memory."
    },
    "Not available in private windows" : {
      "comment" : "Title of the empty state of Settings › Assistant › Memory in a private window."
    },
    "A private window keeps no notes about you, and the assistant uses none there." : {
      "comment" : "Caption of the empty state of Settings › Assistant › Memory in a private window."
    },
    "Remember things about me" : {
      "comment" : "Title of the switch on Settings › Assistant › Memory that turns assistant memory on or off for this profile. Also its Settings search title."
    },
    "New notes need Apple Intelligence, which is off or unavailable. The assistant still uses the notes it has." : {
      "comment" : "Caption under the Remember things about me switch on Settings › Assistant › Memory while memory is on but the on-device model cannot write notes."
    },
    "When this is off, the assistant can’t save or recall anything." : {
      "comment" : "Caption under the Remember things about me switch on Settings › Assistant › Memory."
    },
    "Also forget everything?" : {
      "comment" : "Title of the question shown when the person turns memory off on Settings › Assistant › Memory while notes are kept."
    },
    "Forget Everything" : {
      "comment" : "Default, destructive button of the Also forget everything? question: turns memory off and deletes every note. Title Case."
    },
    "Keep Notes" : {
      "comment" : "Button of the Also forget everything? question: turns memory off and keeps the notes. Title Case."
    },
    "Memory turns off either way. Kept notes stay on this Mac until you forget them." : {
      "comment" : "Message of the Also forget everything? question."
    },
    "Search memory" : {
      "comment" : "Placeholder of the search field above the notes on Settings › Assistant › Memory."
    },
    "Notes" : {
      "comment" : "Title of the section that lists the assistant's notes on Settings › Assistant › Memory. A plural noun."
    },
    "Notes are written on this Mac. When you use a cloud model, the notes it needs are sent with your request. Forgetting a note stops it being used. Earlier conversations keep what they said." : {
      "comment" : "Footnote under the notes on Settings › Assistant › Memory. A cloud model is a model provider on the internet, as opposed to Apple Intelligence on this Mac."
    },
    "Nothing remembered" : {
      "comment" : "Title of the empty state of the notes list on Settings › Assistant › Memory."
    },
    "Things appear here when you answer the assistant or ask it to remember something." : {
      "comment" : "Caption of the empty state of the notes list on Settings › Assistant › Memory."
    },
    "Try a different word." : {
      "comment" : "Caption under No matches when a settings search field finds nothing."
    },
    "Forget All…" : {
      "comment" : "Button under the notes on Settings › Assistant › Memory that asks before deleting every note. Title Case; the ellipsis means it asks first."
    },
    "Forget everything the assistant remembers?" : {
      "comment" : "Title of the confirmation for Forget All… on Settings › Assistant › Memory."
    },
    "Forget All" : {
      "comment" : "Destructive button of the confirmation that deletes every note the assistant keeps. Title Case."
    },
    "The assistant will ask again when it needs these details." : {
      "comment" : "Message of the confirmation that deletes every note the assistant keeps."
    },
    "This can’t be saved. It is too long, or it looks like a password, code or number." : {
      "comment" : "Shown under a note being edited on Settings › Assistant › Memory when the new text is refused."
    },
    "Forget" : {
      "comment" : "Button on a note's row on Settings › Assistant › Memory that deletes that note at once. A verb."
    },
    "Saved %@ from your answer" : {
      "comment" : "Caption of a note on Settings › Assistant › Memory. %@ is the date it was saved, for example Oct 21, 2026. The note came from the person's answer to the assistant's question."
    },
    "Saved %@ from your message" : {
      "comment" : "Caption of a note on Settings › Assistant › Memory. %@ is the date it was saved, for example Oct 21, 2026. The note came from what the person typed."
    },
    "Saved %@ by the assistant" : {
      "comment" : "Caption of a note on Settings › Assistant › Memory. %@ is the date it was saved, for example Oct 21, 2026."
    },
    "Notes about you that the assistant keeps on this Mac. See, edit or forget them." : {
      "comment" : "Settings search result detail for the Remember things about me switch."
    },
    "Read Aloud" : {
      "comment" : "Menu command in View, and the button in Reader's floating bar that reads the article aloud with this Mac's voice, one sentence at a time, marking the sentence being read. It becomes “Pause Reading” and then “Resume Reading” once reading has begun. Title Case."
    },
    "Pause Reading" : {
      "comment" : "Menu command in View, and tooltip and accessibility label of the play/pause button in Reader's floating bar while the article is being read aloud. Pairs with “Resume Reading”. Title Case."
    },
    "Resume Reading" : {
      "comment" : "Menu command in View, and tooltip and accessibility label of the play/pause button in Reader's floating bar while reading aloud is paused. Pairs with “Pause Reading”. Title Case."
    },
    "Stop Reading" : {
      "comment" : "Menu command in View, and tooltip and accessibility label of the stop button in Reader's floating bar. It ends reading aloud and removes the mark from the article. Title Case."
    },
    "Playback speed" : {
      "comment" : "Tooltip and accessibility label of the button in Reader's floating bar that shows how fast the article is read aloud, for example 1.5×, and the label of the slider it opens. The speed goes from 0.5× to 1.5× of the voice's normal pace. Sentence case."
    },
    "Previous Sentence" : {
      "comment" : "Tooltip and accessibility label of the back button in Reader's floating bar while the article is read aloud; it goes to the sentence before. Title Case. Pairs with “Next Sentence”."
    },
    "Next Sentence" : {
      "comment" : "Tooltip and accessibility label of the forward button in Reader's floating bar while the article is read aloud; it goes to the next sentence. Title Case. Pairs with “Previous Sentence”."
    },
    "Block on this site" : {
      "comment" : "Button in an extension's row in Website Settings (the sliders button beside the address). It stops that extension running on the website in front, and on its subdomains. It reads “Allow on this site” while the extension is blocked there. Sentence case, no final full stop."
    },
    "Allow on this site" : {
      "comment" : "Button in an extension's row in Website Settings, shown while that extension is blocked on the website in front. It lets the extension run there again. Sentence case, no final full stop."
    },
    "Allow on %@" : {
      "comment" : "Button in Website Settings, and item in an extension's toolbar-button menu, that lets a blocked extension run on a website again. %@ is the website, for example example.com. In Website Settings it names a parent website only when the block is on that parent and so also covers the page in front. Sentence case, no final full stop. Do not translate the website."
    },
    "Block on %@" : {
      "comment" : "Item in an extension's toolbar-button right-click menu that stops the extension running on the website in front and on its subdomains. %@ is the website, for example example.com. Sentence case, no final full stop. Do not translate the website."
    },
    "Blocked on %@" : {
      "comment" : "Caption under an extension's name in Website Settings while it is blocked on the website in front. %@ is the website that is blocked, for example example.com. Sentence case, no final full stop. Do not translate the website."
    },
    "Extensions run only in WebKit tabs. This tab uses Chromium." : {
      "comment" : "Note in Website Settings, and a disabled item in an extension's toolbar-button menu, shown when the tab in front uses the Chromium engine. Web extensions only run in WebKit tabs, so there is nothing to block or allow there. WebKit and Chromium are engine names and are never translated. Two short sentences."
    },
    "Blocks made in a private window are forgotten when it closes." : {
      "comment" : "Footnote under the per-website extension controls (Website Settings and Settings > Extensions) in a private window. Blocking an extension on a website there is kept only until the private window closes. One sentence."
    },
    "Blocked websites (%lld)" : {
      "comment" : "Label of a folded list under an extension's row in Settings > Extensions. The list holds the websites that extension is blocked on. %lld is how many there are. Sentence case; keep the number in parentheses or equivalent."
    },
    "Allow %@ on %@ again" : {
      "comment" : "Tooltip and spoken hint of the Remove button beside a blocked website in an extension's Blocked websites list in Settings. The first %@ is the extension's name, the second the website, for example example.com. Do not translate either. Sentence case, no final full stop."
    },
    "Removing a website lets the extension run there again and reloads its open tabs." : {
      "comment" : "Footnote under an extension's Blocked websites list in Settings > Extensions. Removing a website from the list lets the extension run on it again, and WSurf reloads that website's open WebKit tabs so the extension's page scripts start. One sentence."
    },
    "Watches read this page with WebKit. Your Chromium sign-ins are not used." : {
      "comment" : "Note shown when a page watch is created or listed for a website set to open in Chromium: watches always read pages with WebKit, so the person's Chromium sign-ins are not used."
    },
    "The page changed." : {
      "comment" : "Body of the notification when a watched page changed, for a watch that waits for any change. Also what the watch reports when Apple Intelligence cannot describe the change."
    },
    "The page now shows what you were waiting for: %@" : {
      "comment" : "Body of the notification when a watched page meets its condition. %@ is what the person is waiting for, in their own words, for example price below $50. The page's own text is never shown."
    },
    "WSurf can’t read this page anymore, so it paused the watch." : {
      "comment" : "Body of the notification when a watched page failed to load three times in a row and its watch was paused."
    },
    "WSurf stopped watching this page after 30 days." : {
      "comment" : "Body of the notification when a page watch ended because it reached its 30-day lifetime."
    },
    "WSurf stopped watching this page because this website’s Assistant Access is now No Access." : {
      "comment" : "Body of the notification, and of the notice in the Watches tab, when a page watch ended because the person set the website's Assistant Access to No Access after the watch began."
    },
    "Page Watches" : {
      "comment" : "Section title on the Tools settings page, above the tools that let the assistant watch a page for a change, and title of the Page Watches section on Settings › Assistant, which is also a Settings search result. Title Case."
