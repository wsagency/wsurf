<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>WSurf Credential Exchange</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- A capability-only credential provider. Apple's exchange API is offered to apps whose extension says so;
	     this extension holds no credentials, so every AutoFill capability is off. It exists for the exchange
	     flags and for the configuration screen the system shows when it is enabled in Passwords settings. -->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>ASCredentialProviderExtensionCapabilities</key>
			<dict>
				<key>ProvidesPasswords</key>
				<false/>
				<key>ProvidesPasskeys</key>
				<false/>
				<key>ProvidesOneTimeCodes</key>
				<false/>
				<key>ShowsConfigurationUI</key>
				<true/>
				<key>SupportsCredentialExchange</key>
				<true/>
				<key>SupportedCredentialExchangeVersions</key>
				<array>
					<string>1.0</string>
				</array>
			</dict>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.authentication-services-credential-provider-ui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).CredentialExchangeProvider</string>
	</dict>
</dict>
</plist>
