<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Every macOS app extension runs sandboxed. Nothing else is requested: no app group, no keychain access
	     group, no network, no file access. The extension has no data channel to the containing app. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
