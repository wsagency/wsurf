<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Every macOS app extension runs sandboxed. The credential-provider entitlement is the standard requirement
	     for an ASCredentialProviderViewController extension; no other data sharing: no app group, keychain access
	     group, network or file access. The extension has no data channel to the containing app. -->
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
